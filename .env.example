# ---------------------------------------------------------------------------
# RazorTrust — environment template. Copy to .env and fill in.
# NEVER commit .env. The AI agent never receives any of these values.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# MVP default: local SQLite. Swap to Postgres by changing DATABASE_URL and the
# provider in packages/db/prisma/schema.prisma.
DATABASE_URL="file:./razortrust.db"

# --- API ------------------------------------------------------------------
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# --- Razorpay -------------------------------------------------------------
# Orders are always created with capture: "manual". RazorTrust never stores a
# payment instrument; it only holds an authorization it can capture or release.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Hard ceiling on how long an authorization may be held before capture.
# Razorpay auto-refunds authorized-but-uncaptured payments after 3 days, so
# 3 days is both the default and the maximum the config loader will accept.
CAPTURE_DEADLINE_HOURS=72

# --- Mandate signing ------------------------------------------------------
# Ed25519 keypair used by the human principal to sign mandates in the demo
# console. In production the private key lives with the human, not the server.
MANDATE_DEMO_PRIVATE_KEY_PEM=""

# --- Audit checkpoints ----------------------------------------------------
# Server-held Ed25519 key that signs periodic hash-chain checkpoints, making
# the append-only log tamper-EVIDENT (a rewrite invalidates the signature).
AUDIT_CHECKPOINT_PRIVATE_KEY_PEM=""
AUDIT_CHECKPOINT_PUBLIC_KEY_PEM=""
AUDIT_CHECKPOINT_EVERY_N_EVENTS=100

# --- AI structuring (messy input -> StructuredQuote only) -----------------
# The model NEVER decides money movement. Its output is Zod-validated and
# discarded on any validation failure.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"
