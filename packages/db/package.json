  },
  "devDependencies": {
    "@prisma/prisma-schema-wasm": "https://registry.npmjs.org/@prisma/prisma-schema-wasm/-/prisma-schema-wasm-5.19.1-2.69d742ee20b815d88e17e54db4a2a7a3b30324e3.tgz",
    "prisma": "5.19.0"
